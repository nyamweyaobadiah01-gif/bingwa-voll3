<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071827"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bundles"
            android:textColor="#F2F4F7"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="One bundle per line:\namount|label|USSD code with {phone}\n\n{phone} is replaced with the customer's number. Each amount can be used once. Codes starting with *334 are blocked."
            android:textColor="#C7D3E3"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#12263D"
            android:gravity="top"
            android:hint="20|My bundle|*123*45*{phone}#"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="10"
            android:padding="12dp"
            android:textColor="#F2F4F7"
            android:textColorHint="#7F93AB"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0 bundle(s) saved"
            android:textColor="#AFC1D6"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save list" />

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Bingwa.Button.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Back" />
    </LinearLayout>
</ScrollView>
