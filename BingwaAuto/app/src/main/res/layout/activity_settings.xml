<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071827"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#F2F4F7"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Auto-send limit (KSh)"
            android:textColor="#F2F4F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Payments above this amount are held for you to approve instead of being sent automatically."
            android:textColor="#AFC1D6"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#12263D"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="#F2F4F7"
            android:textColorHint="#7F93AB"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSaveLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Save limit" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Your data"
            android:textColor="#F2F4F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearHistory"
            style="@style/Widget.Bingwa.Button.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Clear order history" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Bingwa Auto 1.0 by Obadiah Tech\nContact: 0708590547 or nyamweyaobadiah01@gmail.com"
            android:textColor="#AFC1D6"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Bingwa.Button.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Back" />
    </LinearLayout>
</ScrollView>
